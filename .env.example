# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=careercraft

# Backend Authentication
JWT_SECRET=super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Configuration (openai or anthropic)
LLM_PROVIDER=openai

# Gemini (optional; used by chatbot and course recommendations)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChromaDB
CHROMA_DB_URL=http://chromadb:8000
